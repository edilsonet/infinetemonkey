# Cloudflare credentials for the ANAC ingest. Template only: never put real
# values in this file, it is tracked by git.
#
# Copy it to the repo root as `.env` and fill in the values. `.env` is listed in
# .gitignore (line 23) and is never staged. tools/anac_ingest/vectorize_ingest.py
# reads it on start, and a real environment variable always takes priority, so CI
# and shell exports keep working unchanged.
#
#   cp .env.example .env
#
# Token: Cloudflare dashboard > Profile > API Tokens > Create Custom Token
#   https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
#   Account > Workers AI:Read
#   Account > Vectorize:Write
#
# Account id: shown on the dashboard home page.
#   https://dash.cloudflare.com/
#
# Note: `.env` also holds the bearer token the deployed Worker expects
# (ANAC_RAG_TOKEN). That value is set on the Worker itself, not here:
#   cd tools/anac-rag && npx wrangler secret put ANAC_RAG_TOKEN

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=